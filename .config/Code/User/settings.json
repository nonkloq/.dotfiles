{
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "editor.rulers": [
        80
    ],
    "window.zoomLevel": 1,
    "editor.lineNumbers": "relative",
    "window.menuBarVisibility": "compact",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontLigatures": true,
    "editor.suggestFontSize": 14,
    // "editor.suggestLineHeight": 30,
    // "terminal.integrated.lineHeight": 1.5,
    "terminal.integrated.fontSize": 16,
    "editor.minimap.enabled": false,
    "editor.wordWrap": "on",
    "workbench.editor.showTabs": "none",
    // "workbench.editor.enablePreview": false,
    // "breadcrumbs.enabled": false,
    "scm.diffDecorations": "none",
    "editor.hover.delay": 1500,
    "editor.hover.enabled": true,
    // "editor.matchBrackets": "never",
    "workbench.tips.enabled": false,
    // "editor.colorDecorators": false,
    // "git.decorations.enabled": false,
    "workbench.startupEditor": "none",
    "editor.lightbulb.enabled": "off",
    // "editor.selectionHighlight": false,
    "editor.overviewRulerBorder": false,
    "editor.renderLineHighlight": "none",
    "editor.occurrencesHighlight": "off",
    // "problems.decorations.enabled": false,
    "editor.renderControlCharacters": false,
    "editor.hideCursorInOverviewRuler": true,
    // "editor.gotoLocation.multipleReferences": "goto",
    // "editor.gotoLocation.multipleDefinitions": "goto",
    // "editor.gotoLocation.multipleDeclarations": "goto",
    // "workbench.editor.enablePreviewFromQuickOpen": false,
    // "editor.gotoLocation.multipleImplementations": "goto",
    // "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "workbench.navigationControl.enabled": false,
    "chat.commandCenter.enabled": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.emptySelectionClipboard": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.enableTrash": true,
    "editor.formatOnSave": true,
    "ruff.enable": true,
    "ruff.organizeImports": true,
    "ruff.lineLength": 80,
    "ruff.lint.enable": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports.ruff": "explicit"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "search.useIgnoreFiles": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/.git": true,
        "**/.next": true,
        "**/__pycache__": true,
        "**/venv": true,
        "**/.venv": true,
    },
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "sqliteViewer.maxFileSize": 2048,
    // -- Mappings to mimic my Neovim config
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<Tab>"
            ],
            "commands": [
                ":tabnext"
            ]
        },
        {
            "before": [
                "<S-Tab>"
            ],
            "commands": [
                ":tabprevious"
            ]
        },
        {
            "before": [
                "<Space>",
                "x"
            ],
            "commands": [
                ":bd"
            ]
        },
        {
            "before": [
                "<Space>",
                "f",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ] // Ctrl+P / Cmd+P
        },
        // Live grep (find word in files)
        {
            "before": [
                "<Space>",
                "s",
                "w"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ] // Ctrl+Shift+F
        },
        // Find open files in buffer (like Telescope buffers)
        {
            "before": [
                "<Space>",
                "f",
                "b"
            ],
            "commands": [
                "workbench.action.showAllEditors"
            ] // Show open editors (buffers)
        },
        // Find word in current buffer (like Telescope current_buffer_fuzzy_find)
        {
            "before": [
                "<Space>",
                "f",
                "s"
            ],
            "commands": [
                "actions.find"
            ] // Ctrl+F
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "<space>",
                "l",
                "r"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "<space>",
                "l",
                "c"
            ],
            "commands": [
                "editor.action.peekDefinition"
            ]
        },
        {
            "before": [
                "<Space>",
                "a",
                "a"
            ],
            "commands": [
                "workbench.panel.chat"
                // "workbench.action.toggleAuxiliaryBar"
            ]
        },
        {
            "before": [
                "<space>",
                "d",
                "s"
            ],
            "commands": [
                "workbench.actions.view.problems"
            ]
        },
        {
            "before": [
                "<Space>",
                "f",
                "w"
            ],
            "commands": [
                {
                    "command": "workbench.action.quickOpen",
                    "args": "%",
                    "when": "editorTextFocus"
                }
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<Space>",
                "/"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        {
            "before": [
                "space",
                "a",
                "e"
            ],
            "commands": [
                "interactiveEditor.start"
            ]
        }
    ],
    "vim.useCtrlKeys": true,
    // Custom css
    "vscode_custom_css.imports": [
        "file:///home/satz/.config/Code/User/style.css",
    ],
    "vscode_custom_css.statusbar": false,
    "workbench.activityBar.location": "hidden",
    "workbench.layoutControl.enabled": false,
}
